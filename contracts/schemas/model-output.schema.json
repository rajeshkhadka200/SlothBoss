{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slothboss.dev/schemas/model-output.v1.json",
  "title": "Structured outputs requested from the local model",
  "description": "Each $defs entry is sent verbatim as the Ollama /api/chat 'format' parameter for the matching feature. Constrained decoding is a convenience, not a guarantee: the application re-parses and re-validates every response (see docs/ARCHITECTURE.md#ai-safety) and retries at most twice.",
  "$defs": {
    "ask": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["answered", "partial", "not_found"] },
        "answer": { "type": "string" },
        "citations": { "type": "array", "items": { "type": "string" } },
        "inferences": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["status", "answer", "citations", "inferences"]
    },
    "extract_tasks": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
              "due_date": { "type": "string" },
              "evidence": { "type": "string" }
            },
            "required": ["title", "description", "priority", "due_date", "evidence"]
          }
        }
      },
      "required": ["tasks"]
    },
    "plan_tasks": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
              "source": { "type": "string" },
              "rationale": { "type": "string" }
            },
            "required": ["title", "description", "priority", "source", "rationale"]
          }
        }
      },
      "required": ["summary", "tasks"]
    },
    "draft_note": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "markdown": { "type": "string" },
        "citations": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "markdown", "citations"]
    },
    "agent_plan": {
      "type": "object",
      "properties": {
        "understanding": { "type": "string" },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": { "type": "string", "enum": ["files.list", "files.find_duplicates", "files.plan_organization", "files.apply_organization",
                                                    "docs.summarize", "docs.extract_actions", "tasks.create", "notes.search", "report.create",
                                                    "web.search", "web.read", "research.report"] },
              "purpose": { "type": "string" },
              "strategy": { "type": "string", "enum": ["by_type", "by_topic"] },
              "rename_unclear": { "type": "boolean" },
              "selection": { "type": "string", "enum": ["important", "pdfs", "all"] },
              "max_documents": { "type": "integer" },
              "query": { "type": "string" },
              "max_results": { "type": "integer" },
              "max_pages": { "type": "integer" },
              "save_copy_in_folder": { "type": "boolean" }
            },
            "required": ["tool", "purpose"]
          }
        },
        "completion_criteria": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["understanding", "missing_information", "steps", "completion_criteria"]
    },
    "agent_research_report": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": { "type": "string" },
              "sources": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "string", "enum": ["verified", "likely", "uncertain"] }
            },
            "required": ["claim", "sources", "confidence"]
          }
        },
        "recommendation": { "type": "string" },
        "caveats": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "summary", "findings", "recommendation", "caveats"]
    },
    "agent_organize": {
      "type": "object",
      "properties": {
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "file": { "type": "string" }, "folder": { "type": "string" }, "new_name": { "type": "string" } },
            "required": ["file", "folder", "new_name"]
          }
        }
      },
      "required": ["assignments"]
    },
    "agent_select": {
      "type": "object",
      "properties": { "files": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string" } },
      "required": ["files", "reason"]
    },
    "agent_doc_summary": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "key_points": { "type": "array", "items": { "type": "string" } },
        "document_type": { "type": "string" }
      },
      "required": ["summary", "key_points", "document_type"]
    }
  }
}
