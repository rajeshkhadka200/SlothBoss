<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SlothBoss.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlothBoss.Core.Tests" />
  </ItemGroup>

  <!-- Shared contracts are embedded verbatim so the Windows client runs exactly the same
       migration SQL, prompts and output schemas as the macOS client. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\contracts\schema\*.sql" LogicalName="schema.%(Filename).sql" />
    <EmbeddedResource Include="..\..\..\..\contracts\prompts\*.md" LogicalName="prompts.%(Filename).md" />
    <EmbeddedResource Include="..\..\..\..\contracts\schemas\model-output.schema.json" LogicalName="model-output.schema.json" />
  </ItemGroup>

</Project>
