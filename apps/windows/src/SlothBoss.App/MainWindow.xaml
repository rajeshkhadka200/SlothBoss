<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SlothBoss.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SlothBoss.App"
    xmlns:controls="using:SlothBoss.App.Controls"
    Title="SlothBoss">

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewPageAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnNewSubpageAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="J" Invoked="OnAssistantAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" Invoked="OnTasksAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="H" Invoked="OnHomeAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/SlothBoss.png" Width="18" Height="18" />
                <TextBlock Text="SlothBoss" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleBarPage" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Padding="8,0,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="NavList" Grid.Row="0" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnNavItemClick" AutomationProperties.Name="Main navigation">
                    <ListViewItem Tag="home" AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="16" /><TextBlock Text="Home" /></StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="runs" AutomationProperties.Name="Jobs" ToolTipService.ToolTip="Everything SlothBoss has done for you">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE945;" FontSize="16" /><TextBlock Text="Jobs" /></StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="tasks" AutomationProperties.Name="Tasks" ToolTipService.ToolTip="Tasks (Ctrl+Shift+T)">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D5;" FontSize="16" /><TextBlock Text="Tasks" /></StackPanel>
                    </ListViewItem>
                </ListView>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FavoritesHeader" Text="FAVORITES" Style="{StaticResource SidebarHeaderTextStyle}" />
                        <ListView x:Name="FavoritesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnFavoriteClick"
                                  AutomationProperties.Name="Favorite pages">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PageNode">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource SlothAccentBrush}" />
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Margin="0,4,4,0">
                            <TextBlock Text="NOTES &amp; REPORTS" Style="{StaticResource SidebarHeaderTextStyle}" />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource ToolbarButtonStyle}"
                                    Click="OnNewPageClick" ToolTipService.ToolTip="New page (Ctrl+N)" AutomationProperties.Name="New page">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TreeView x:Name="PageTree" SelectionMode="Single" ItemInvoked="OnPageInvoked" CanDragItems="False" AllowDrop="False"
                                  AutomationProperties.Name="Pages">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="local:PageNode">
                                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind Title}">
                                        <TreeViewItem.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open" Tag="{x:Bind Id}" Click="OnTreeOpen" />
                                                <MenuFlyoutItem Text="New subpage" Tag="{x:Bind Id}" Click="OnTreeNewSubpage">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Rename…" Tag="{x:Bind Id}" Click="OnTreeRename">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind FavoriteLabel}" Tag="{x:Bind Id}" Click="OnTreeFavorite">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Move to…" Tag="{x:Bind Id}" Click="OnTreeMove">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DE;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Export as Markdown…" Tag="{x:Bind Id}" Click="OnTreeExport">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Archive" Tag="{x:Bind Id}" Click="OnTreeArchive">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Delete…" Tag="{x:Bind Id}" Click="OnTreeDelete">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </TreeViewItem.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock x:Name="EmptyTreeText" Margin="16,4,8,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="No pages yet. Press Ctrl+N to create one." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button x:Name="AiStatusButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolbarButtonStyle}" Height="Auto" Padding="12,8" Click="OnAiStatusClick"
                            AutomationProperties.Name="Local AI status">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="AiStatusDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiStatusText" Text="Checking for Ollama…" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </Button>
                    <ListView x:Name="FooterNav" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavItemClick">
                        <ListViewItem Tag="settings" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="Settings" /></StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid>
                    <Frame x:Name="ContentFrame" />
                    <InfoBar x:Name="GlobalInfoBar" IsOpen="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             Margin="24" MaxWidth="640" />
                </Grid>
            </Border>

            <!-- Assistant -->
            <controls:AssistantPanel x:Name="Assistant" Grid.Column="2" Width="420" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
