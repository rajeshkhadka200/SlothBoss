<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SlothBoss.App.Views.AgentRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="40,28,40,48" Spacing="10">
            <TextBlock Text="AGENT JOB" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SlothAccentBrush}" FontWeight="SemiBold" />
            <TextBlock x:Name="GoalText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border x:Name="StateBadge" CornerRadius="10" Padding="10,2">
                    <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="White" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False" />
            </StackPanel>
            <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PauseButton" Click="OnPause"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE769;" FontSize="13" /><TextBlock Text="Pause" /></StackPanel></Button>
                <Button x:Name="ResumeButton" Click="OnResume" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Resume" /></StackPanel></Button>
                <Button x:Name="CancelButton" Click="OnCancel"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="13" /><TextBlock Text="Cancel job" /></StackPanel></Button>
                <Button x:Name="RetryButton" Click="OnRetry"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" /><TextBlock Text="Retry failed steps" /></StackPanel></Button>
                <Button x:Name="UndoButton" Click="OnUndo"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A7;" FontSize="13" /><TextBlock Text="Undo this job" /></StackPanel></Button>
                <Button x:Name="ReportButton" Click="OnOpenReport"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A5;" FontSize="13" /><TextBlock Text="Open report" /></StackPanel></Button>
            </StackPanel>

            <!-- What the agent needs from the user -->
            <Border x:Name="AttentionCard" Style="{StaticResource CardBorderStyle}" BorderBrush="{ThemeResource SlothWarningBrush}" BorderThickness="2" Visibility="Collapsed">
                <StackPanel x:Name="AttentionPanel" Spacing="8" />
            </Border>

            <!-- Final, verified outcome -->
            <Border x:Name="ReportCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel x:Name="ReportPanel" Spacing="6" />
            </Border>

            <TextBlock Text="Plan" Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock x:Name="UnderstandingText" TextWrapping="Wrap" />
            <StackPanel x:Name="StepsPanel" Spacing="6" />
            <StackPanel x:Name="CriteriaPanel" Spacing="2" />

            <Expander x:Name="LogExpander" Header="Activity log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,12,0,0">
                <StackPanel x:Name="LogPanel" Spacing="2" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
