<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SlothBoss.App.Views.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="40,28,40,48" Spacing="4">
            <TextBlock Text="Archive" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Archived pages are hidden from the sidebar, search and the assistant. Restoring brings back the page and its subpages."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
            <StackPanel x:Name="List" Spacing="4" />
            <TextBlock x:Name="EmptyText" Text="Nothing is archived." Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
