<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SlothBoss.App.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,0" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Tasks" Style="{StaticResource PageTitleTextStyle}" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" Click="OnNewTask">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New task" /></StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <ComboBox x:Name="StatusFilter" Header="Status" MinWidth="140" SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="PriorityFilter" Header="Priority" MinWidth="140" SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="DueFilterBox" Header="Due" MinWidth="150" SelectionChanged="OnFilterChanged" />
            <CheckBox x:Name="HideDone" Content="Hide completed" VerticalAlignment="Bottom" Click="OnFilterChanged" />
            <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="8,0,0,8"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="TaskList" SelectionMode="None" IsItemClickEnabled="False" Padding="0,0,0,40"
                      AutomationProperties.Name="Task list" />
            <StackPanel x:Name="EmptyState" VerticalAlignment="Top" Margin="0,40,0,0" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE9D5;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
