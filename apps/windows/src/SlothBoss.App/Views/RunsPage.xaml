<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SlothBoss.App.Views.RunsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="40,28,40,48" Spacing="4">
            <TextBlock Text="Agent jobs" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"
                       Text="Every job SlothBoss ran, with its plan, approvals, results and checks. Jobs are saved, so they survive restarts." />
            <StackPanel x:Name="List" Spacing="4" />
            <TextBlock x:Name="EmptyText" Text="No jobs yet. Start one from Home." Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
