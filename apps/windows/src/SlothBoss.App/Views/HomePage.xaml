<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SlothBoss.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conversation: each request and what SlothBoss did with it -->
        <ScrollViewer x:Name="ThreadScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="40,24,40,16" Spacing="14">
                <StackPanel x:Name="Welcome" Spacing="10" Margin="0,24,0,8">
                    <TextBlock Text="What should SlothBoss do for you?" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Say what you want, not how to do it. SlothBoss works it out, does the boring parts, asks before anything important changes, and gives you the result." />
                    <TextBlock Text="Try one of these:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" />
                    <StackPanel x:Name="ExampleList" Spacing="6" />
                </StackPanel>
                <InfoBar x:Name="AiSetupBar" IsOpen="False" IsClosable="False" Title="The local AI isn't ready">
                    <InfoBar.ActionButton>
                        <Button Content="Open settings" Click="OnOpenSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="Thread" Spacing="14" />
            </StackPanel>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="40,12,40,16">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MicButton" Grid.Column="1" VerticalAlignment="Stretch" Click="OnMic" MinWidth="64"
                            AutomationProperties.Name="Speak your request" ToolTipService.ToolTip="Speak instead of typing (uses ElevenLabs; your recording is sent to ElevenLabs to turn it into text)">
                        <StackPanel Spacing="4"><FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="16" /><TextBlock x:Name="MicText" Text="Speak" /></StackPanel>
                    </Button>
                    <TextBox x:Name="CaptureBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="150"
                             PlaceholderText="Tell SlothBoss what you want done… (Ctrl+Enter to send)" KeyDown="OnCaptureKeyDown"
                             AutomationProperties.Name="What should SlothBoss get done" />
                    <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Stretch" Click="OnStart"
                            AutomationProperties.Name="Start agent job" ToolTipService.ToolTip="Send (Ctrl+Enter)">
                        <StackPanel Spacing="4"><FontIcon Glyph="&#xE724;" FontSize="16" /><TextBlock Text="Send" /></StackPanel>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="FolderBox" MinWidth="230" MaxWidth="330" PlaceholderText="No folder" AutomationProperties.Name="Approved folder"
                              ToolTipService.ToolTip="The only folder SlothBoss may work in" />
                    <Button Click="OnApproveFolder" ToolTipService.ToolTip="Give SlothBoss access to one folder (and its subfolders)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Folder…" /></StackPanel>
                    </Button>
                    <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="OnModeChanged" AutomationProperties.Name="How much it does on its own">
                        <ComboBoxItem Content="Ask me first" AutomationProperties.Name="Assist" ToolTipService.ToolTip="Asks before every change" />
                        <ComboBoxItem Content="Autopilot" AutomationProperties.Name="Autopilot" ToolTipService.ToolTip="Does low-risk work alone; asks before changing files" />
                        <ComboBoxItem Content="Approve plan once" AutomationProperties.Name="Supervised" ToolTipService.ToolTip="You approve the plan once" />
                    </ComboBox>
                    <HyperlinkButton x:Name="WebChip" Click="OnOpenSettings" Padding="6,4" />
                    <CheckBox x:Name="NoAiCheck" Content="Without AI (tidy folders only)" Visibility="Collapsed" MinWidth="0" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More capture options">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Save as a task instead" Click="OnAddTask"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as a note instead" Click="OnSaveNote"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Create a practice folder" Click="OnPracticeFolder"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BE;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="All jobs" Click="OnAllJobs"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ModeHelp" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
