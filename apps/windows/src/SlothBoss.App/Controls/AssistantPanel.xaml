<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SlothBoss.App.Controls.AssistantPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
          Background="{ThemeResource LayerFillColorAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="16,12,8,8">
            <StackPanel Spacing="2">
                <TextBlock Text="Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnClear" ToolTipService.ToolTip="Clear conversation" AutomationProperties.Name="Clear conversation">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnClose" ToolTipService.ToolTip="Close (Ctrl+J)" AutomationProperties.Name="Close assistant">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Page context actions -->
        <StackPanel x:Name="PageContext" Grid.Row="1" Padding="16,0,16,8" Spacing="6">
            <TextBlock x:Name="PageContextText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="SummarizeButton" Click="OnSummarize">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="13" /><TextBlock Text="Summarize page" /></StackPanel>
                </Button>
                <Button x:Name="ExtractButton" Click="OnExtract">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D5;" FontSize="13" /><TextBlock Text="Extract tasks" /></StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Conversation -->
        <ScrollViewer x:Name="MessagesScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,4,16,8">
            <StackPanel x:Name="Messages" Spacing="12">
                <StackPanel x:Name="Intro" Spacing="8" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Ask questions about your notes, plan follow-up tasks, or draft a new note. Answers cite the pages they come from. Proposed changes wait for your approval." />
                    <HyperlinkButton x:Name="ExampleAsk" Content="What open questions do my notes mention?" Click="OnExample" Padding="0" />
                    <HyperlinkButton x:Name="ExamplePlan" Content="Review my research notes and propose tasks for unresolved questions" Click="OnExample" Padding="0" Tag="plan" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Composer -->
        <StackPanel Grid.Row="3" Padding="16,8,16,16" Spacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="Assistant mode">
                    <ComboBoxItem Content="Ask about my notes" Tag="ask" />
                    <ComboBoxItem Content="Plan tasks from my notes" Tag="plan" />
                    <ComboBoxItem Content="Draft a new note" Tag="draft" />
                </ComboBox>
                <CheckBox x:Name="FocusPage" Grid.Column="1" Content="Use this page" MinWidth="0" IsChecked="True"
                          ToolTipService.ToolTip="Include the open page in the evidence, in addition to search results" />
            </Grid>
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                     PlaceholderText="Ask something… (Ctrl+Enter to send)" KeyDown="OnInputKeyDown" AutomationProperties.Name="Message to the assistant" />
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                    <TextBlock x:Name="BusyText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Visibility="Collapsed" />
                    <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}" Click="OnSend" AutomationProperties.Name="Send">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE724;" FontSize="13" /><TextBlock Text="Send" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
