{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slothboss.dev/schemas/backup.v1.json",
  "title": "SlothBoss workspace backup, format version 1",
  "type": "object",
  "required": ["format", "formatVersion", "schemaVersion", "exportedAt", "pages", "tasks"],
  "properties": {
    "format": { "const": "slothboss-backup" },
    "formatVersion": { "const": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string" },
    "generator": { "type": "string", "description": "Informational, e.g. 'SlothBoss Windows 0.1.0'." },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "content", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "content": { "$ref": "content.schema.json" },
          "sortOrder": { "type": "number" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "isFavorite": { "type": "boolean" },
          "isArchived": { "type": "boolean" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "priority", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "status": { "enum": ["todo", "in_progress", "done"] },
          "priority": { "enum": ["low", "medium", "high", "urgent"] },
          "dueDate": { "type": ["string", "null"] },
          "pageId": { "type": ["string", "null"] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "completedAt": { "type": ["string", "null"] }
        }
      }
    }
  }
}
